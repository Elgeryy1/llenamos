# En local todo va contra los emuladores de Firebase: no hace falta cuenta.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-llenamos
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-llenamos.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-llenamos.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id
NEXT_PUBLIC_USE_EMULATORS=1
NEXT_PUBLIC_FUNCTIONS_REGION=europe-west1

# Producción VPS: Firebase solo Auth; compilar con NEXT_PUBLIC_DATA_BACKEND=postgres.
# En demo con emuladores, dejar sin definir o usar firebase-demo.
# No publicar hasta completar la migración: operaciones pendientes devuelven error.
# NEXT_PUBLIC_DATA_BACKEND=postgres

# Opcional: dónde están los emuladores. Si no se ponen, se usan los puertos del
# contrato (ARQUITECTURA.md). Solo hace falta cambiarlos si otro proceso ya los usa.
# NEXT_PUBLIC_EMULATOR_HOST=127.0.0.1
# NEXT_PUBLIC_AUTH_EMULATOR_PORT=9099
# NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=8085
# NEXT_PUBLIC_FUNCTIONS_EMULATOR_PORT=5001
# NEXT_PUBLIC_STORAGE_EMULATOR_PORT=9199

# Dirección pública de la web. Sirve para los enlaces de compartir de la página de
# reservas (imagen y título en WhatsApp o redes). En local vale http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://llenamos.logiqd.me

# Política aprobada para las casillas opcionales. Sin versión no se muestran fuera del emulador.
# NEXT_PUBLIC_MARKETING_POLICY_VERSION=
# NEXT_PUBLIC_MARKETING_POLICY_URL=
