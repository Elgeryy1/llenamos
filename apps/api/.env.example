FIREBASE_PROJECT_ID=llenamos-logiqd
DATABASE_URL_FILE=/run/secrets/llenamos_api_database_url
PORT=3100
HOST=0.0.0.0
IDENTITY_ADMIN_CREDENTIAL_FILE=
PLATFORM_INVITATION_KEY_FILE=
PLATFORM_INTEGRATION_KEY_FILE=
PLATFORM_EMAIL_ENABLED=0
PUBLIC_APP_URL=
RESEND_API_KEY_FILE=
EMAIL_FROM=
# Plataforma (alta por cuenta propia y Stripe Billing). Vacío = sin cobro ni alta propia.
# El alta propia exige además platform_flags('self_signup') en la base (ver modules/plataforma/README.md).
PLATFORM_SELF_SIGNUP=0
STRIPE_BILLING_SECRET_KEY_FILE=
STRIPE_BILLING_WEBHOOK_SECRET_FILE=
STRIPE_BILLING_RETURN_ORIGIN=
# Solo comando de migración, nunca incluir en el servicio HTTP:
# MIGRATION_DATABASE_URL_FILE=/ruta/privada/conexion_bootstrap
