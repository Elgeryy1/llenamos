{
  "name": "@llenamos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": ["dist", "migrations"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "migrate": "tsx src/migrate.ts"
  },
  "dependencies": { "@llenamos/core": "workspace:*", "firebase-admin": "14.5.0", "jose": "6.2.17", "pg": "8.23.1", "zod": "^4.6.7" },
  "devDependencies": { "@types/node": "^26.6.6", "@types/pg": "8.23.1", "tsup": "^9.0.0", "tsx": "^4.23.15", "typescript": "^7.0.2", "vitest": "^5.1.0" }
}
