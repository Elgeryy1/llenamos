# Usar referencias inmutables por digest obtenidas del registro privado.
WEB_IMAGE=
GATEWAY_IMAGE=
TUNNEL_IMAGE=
TUNNEL_TOKEN_FILE=./secrets/tunnel_token
# Destino nuevo; requiere roles/migraciones y credenciales separadas antes de arrancar.
API_IMAGE=
POSTGRES_BOOTSTRAP_PASSWORD_FILE=./secrets/postgres_bootstrap_password
API_DATABASE_URL_FILE=./secrets/api_database_url
# Sólo compose.identity.yaml: cuenta de servicio limitada a Firebase Auth, nunca datos.
FIREBASE_AUTH_ADMIN_FILE=./secrets/firebase_auth_admin.json
# Dos claves independientes de 32 bytes, cada archivo contiene 64 caracteres hexadecimales.
PLATFORM_INVITATION_KEY_FILE=./secrets/platform_invitation_key
PLATFORM_INTEGRATION_KEY_FILE=./secrets/platform_integration_key
# compose.worker.yaml: tercera clave de 32 bytes (64 hex) para los enlaces de sala; `openssl rand -hex 32 > secrets/sala_secret_key`.
SALA_SECRET_KEY_FILE=./secrets/sala_secret_key
# Avisos al móvil de tareas de sala vencidas (Web Push, claves VAPID P-256). Generar el par una vez, p. ej. con
# `npx web-push generate-vapid-keys --json`; la privada (base64url) va en el archivo, la pública y el contacto como variables.
# El archivo debe existir aunque esté vacío: vacío = sin avisos (la pantalla dice «Sin configurar» y no se envía nada).
VAPID_PRIVATE_KEY_FILE=./secrets/vapid_private_key
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:avisos@logiqd.me
# Sólo compose.mail.yaml; sin correo, altas/invitaciones siguen pendientes e inactivas.
PUBLIC_APP_URL=https://app-llenamos.logiqd.me
PLATFORM_EMAIL_FROM=
PLATFORM_RESEND_KEY_FILE=./secrets/platform_resend_key
# Configuración PÚBLICA de Firebase Auth para compilar la web (build-args; vars de GitHub en vps-images.yml). No son secretos.
# Proyecto de producción llenamos-logiqd (app web ya creada). La clave de API se copia de la consola (Configuración del proyecto). Authentication aún hay que inicializarlo con el proveedor correo y contraseña.
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=llenamos-logiqd
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=llenamos-logiqd.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_APP_ID=1:844781008037:web:74dee224fcac157c51894c
# NEXT_PUBLIC_SITE_URL=https://app-llenamos.logiqd.me
# Authentication > Configuración > Dominios autorizados: añadir llenamos.logiqd.me y app-llenamos.logiqd.me (hacen falta para el inicio de sesión; el enlace del correo de recuperación va al gestor de firebaseapp.com y no depende de ellos).
