# Avisos al móvil. Sin un par P-256 válido y contacto no se envía nada.
# Prueba local: node scripts/generar-vapid.mjs > functions/.env.local
# Reinicia los emuladores después de cambiarlo. En emuladores solo se captura.
# Nunca publiques la clave privada con NEXT_PUBLIC_ ni la subas a git.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
